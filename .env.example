# Base URL for the DocMind API. Leave as /api so the Vite dev proxy (and the
# same-origin production build) both work without code changes.
VITE_API_BASE_URL=/api

# Where the Vite dev server proxies /api during development.
VITE_PROXY_TARGET=http://localhost:4500

# Password recovery UI is built but the backend endpoints do not exist yet
# (plan §13.3 / §20.4 #8). Flip to true once POST /api/auth/forgot-password and
# POST /api/auth/reset-password ship.
VITE_FEATURE_PASSWORD_RESET=false

# Chat history is session-scoped; there is no conversations table yet (§22 #3).
VITE_FEATURE_CHAT_HISTORY=false

# Serve the app against in-browser MSW mocks instead of the real API. Useful for
# UI work and for the Playwright suite when no backend/DB/Pinecone is available.
VITE_ENABLE_MOCK_API=false
